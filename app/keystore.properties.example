# Copia este archivo a `keystore.properties` y rellénalo.
# `keystore.properties` está en .gitignore: nunca lo subas.
#
# Para generar el almacén (te pedirá las contraseñas de forma interactiva):
#
#   keytool -genkeypair -v \
#     -keystore app/webanywhere.jks \
#     -alias webanywhere \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Guarda una copia del .jks y de las contraseñas fuera del repo. Si los pierdes
# no podrás publicar actualizaciones sobre la app ya instalada: Android trata
# una firma distinta como una app distinta y obliga a desinstalar primero.

storeFile=webanywhere.jks
storePassword=
keyAlias=webanywhere
keyPassword=
